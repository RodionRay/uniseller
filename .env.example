# --- Required (GET /api/health reports missing/invalid names) ---
# 64 hex chars: openssl rand -hex 32   (store a copy OUTSIDE the server: without it secrets in the DB are unreadable)
ENCRYPTION_KEY=
# >= 32 chars: openssl rand -base64 48
SESSION_SECRET=
# shared web <-> worker token: openssl rand -hex 32   (worker refuses to start without it in production)
TG_WORKER_TOKEN=
# worker -> /api/cron/auto-rescan bearer: openssl rand -hex 32   (required in production)
CRON_SECRET=
# public URL of the cabinet; https://… makes session cookies Secure and is the OAuth callback origin
APP_URL=http://127.0.0.1:5173

# --- Access ---
ADMIN_EMAIL=admin@uniseller.local
# npm run auth:hash -- 'your-password'
ADMIN_PASSWORD_HASH=
# self-registration (email and new OAuth/Telegram users); closed unless exactly "true"
REGISTRATION_OPEN=false

# --- Telegram worker ---
TELEGRAM_WORKER_URL=http://127.0.0.1:8790
TG_WORKER_PORT=8790
# bind address; Docker sets 0.0.0.0
TG_WORKER_HOST=127.0.0.1
# parallel python jobs
TG_WORKER_CONCURRENCY=4
# optional overrides: TG_WORKER_PYTHON, TG_WORKER_SCRIPT, TG_WORKER_KILL_GRACE_MS,
# TG_WORKER_MAX_OUTPUT_BYTES, TG_WORKER_ALLOW_NO_TOKEN=1 (never in production)
# how often the worker triggers auto-rescan (ms), default 5 min
# AUTO_RESCAN_EVERY_MS=300000

# --- Local D1 (wrangler) ---
# persist dir of the local D1; Docker uses /data/wrangler
# D1_PERSIST_DIR=.wrangler/state

# --- Social login (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Contact form -> Telegram (optional) ---
CONTACT_BOT_TOKEN=
CONTACT_CHAT_ID=

# --- AI (optional) ---
AI_PROVIDER=deepseek
AI_API_BASE=https://api.deepseek.com
AI_API_KEY=
