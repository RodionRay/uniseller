# --- Required (GET /api/health reports missing/invalid names) ---
# 64 hex chars: openssl rand -hex 32   (store a copy OUTSIDE the server: without it secrets in the DB are unreadable)
ENCRYPTION_KEY=
# >= 32 chars: openssl rand -base64 48
SESSION_SECRET=
# shared web <-> worker token, >= 32 chars: openssl rand -hex 32   (the worker refuses to start without it;
# npm run dev generates a per-run value when empty)
TG_WORKER_TOKEN=
# worker -> /api/cron/auto-rescan bearer, >= 32 chars, separate from TG_WORKER_TOKEN: openssl rand -hex 32
# (without it auto-rescan is off: the worker warns once at start; npm run dev generates one when empty)
CRON_SECRET=
# public URL of the cabinet; https://… makes session cookies Secure and is the OAuth callback origin
APP_URL=http://127.0.0.1:5173

# --- Access ---
ADMIN_EMAIL=admin@uniseller.local
# npm run auth:hash -- 'your-password'
ADMIN_PASSWORD_HASH=
# self-registration (email and new OAuth/Telegram users); closed unless exactly "true"
REGISTRATION_OPEN=false

# --- Telegram worker ---
TELEGRAM_WORKER_URL=http://127.0.0.1:8790
TG_WORKER_PORT=8790
# bind address; Docker sets 0.0.0.0
TG_WORKER_HOST=127.0.0.1
# parallel python jobs (older name TG_WORKER_CONCURRENCY is still read)
TG_WORKER_MAX_CONCURRENCY=4
# requests waiting beyond MAX_CONCURRENCY; past that the worker answers 429
# TG_WORKER_MAX_QUEUE=64
# extra Host headers the worker accepts besides 127.0.0.1/localhost, comma-separated (Docker: worker:8790)
# TG_WORKER_ALLOWED_HOSTS=
# plain-http APP_URL hosts the worker may send CRON_SECRET to (private network only; Docker: web)
# TG_WORKER_CRON_HTTP_HOSTS=
# optional overrides: TG_WORKER_PYTHON, TG_WORKER_SCRIPT, TG_WORKER_KILL_GRACE_MS,
# TG_WORKER_MAX_OUTPUT_BYTES (base cap, check-proxy; account actions get >= 8 MiB),
# TG_WORKER_TIMEOUT_MS (one timeout for every action), TG_WORKER_AUTO_RESCAN=0 (disable the cron tick),
# TG_WORKER_MAX_BODY_BYTES (request body cap, default 6000000)
# extra env names passed to the Python child (it gets no app secrets by default), comma-separated
# TG_WORKER_PYTHON_ENV=
# how often the worker triggers auto-rescan (ms), default 5 min
# AUTO_RESCAN_EVERY_MS=300000

# --- Client IP for per-IP rate limits ---
# Header the proxy in front OVERWRITES with the real client IP (default: none, no header trusted).
# Without such a proxy (local dev, Docker/VPS via wrangler dev --local) it is client-controlled:
# none = per-IP limits off, per-email/per-user/global limits stay. Behind the Caddy of docs/DEPLOY.md: x-real-ip.
# TRUSTED_IP_HEADER=none

# --- Local D1 (wrangler) ---
# persist dir of the local D1; Docker uses /data/wrangler
# D1_PERSIST_DIR=.wrangler/state
# backups: node scripts/d1-backup.mjs (Docker sets BACKUP_DIR=/data/backups)
# BACKUP_DIR=
# BACKUP_KEEP=14
# seed:tgstat-catalog owner id
# SEED_OWNER=local_seedy

# --- Social login (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Contact form -> Telegram (optional) ---
CONTACT_BOT_TOKEN=
CONTACT_CHAT_ID=

# --- AI (optional) ---
AI_PROVIDER=deepseek
AI_API_BASE=https://api.deepseek.com
AI_API_KEY=
# optional: AI_MODEL (default deepseek model); DEEPSEEK_API_KEY is a fallback for AI_API_KEY
# AI_MODEL=
# in-app assistant: key ASSISTANT_OPENAI_KEY > OPENAI_API_KEY > AI_API_KEY > DEEPSEEK_API_KEY
# ASSISTANT_OPENAI_KEY=
# ASSISTANT_MODEL=
# daily assistant questions per signed-in user (default 200)
# ASSISTANT_USER_DAILY_LIMIT=200
